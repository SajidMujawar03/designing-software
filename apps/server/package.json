{
  "name": "@figma/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "start": "node --enable-source-maps dist/index.mjs",
    "typecheck": "tsc -p .",
    "loadtest": "tsx scripts/loadtest.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --target=node22 --format=esm --packages=external --sourcemap --outfile=dist/index.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.17",
    "@fastify/cookie": "^11.1.5",
    "@hocuspocus/server": "2.15.3",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.8",
    "pg": "^8.23.1",
    "ws": "^8.18.0",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.20",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@hocuspocus/provider": "2.15.3",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "@types/ws": "^8.5.13",
    "esbuild": "0.21.5",
    "tsx": "^4.23.15"
  }
}
