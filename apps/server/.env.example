# Copy to .env (or set in your shell) to change server settings. All optional in development.

# Port of the API + realtime server. The web dev server proxies /api and /collab here.
PORT=5281

# Where the web app is served (OAuth redirects, share links).
PUBLIC_URL=http://localhost:5280

# Use a real Postgres server. Without it, an embedded Postgres (PGlite) stores data in DATA_DIR.
# Example for a local PostgreSQL install, after: CREATE ROLE figma LOGIN PASSWORD 'figma'; CREATE DATABASE figma OWNER figma;
# DATABASE_URL=postgres://figma:figma@localhost:5432/figma
DATA_DIR=.data/pg
# Automatic backups of the embedded database (to <DATA_DIR>-backups), at most every 6 hours. Restore: pnpm --filter @figma/server db:restore
# DB_BACKUPS=off

# Google sign-in (https://console.cloud.google.com/apis/credentials, OAuth client "Web application",
# authorized redirect URI: http://localhost:5280/api/auth/google/callback). Leave empty to hide the button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Production (see docs/deploy.md). The built web app in WEB_DIST (default apps/web/dist) is served too.
# WEB_DIST=
# TRUST_PROXY=true      # behind a reverse proxy or load balancer

# Error reporting. Errors are always logged as JSON lines; with a DSN they also go to Sentry.
# SENTRY_DSN=https://<key>@o0.ingest.sentry.io/<project>
# RELEASE=dev

# Development test accounts (created on the local embedded database while testing):
#   ada@example.test / analytical1
#   grace@example.test / compiler-1952
