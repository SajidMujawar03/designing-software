# Copy to .env.local to change web app settings. All optional.

# Also send the app's error reports to Sentry (they always go to the app's server at /api/errors).
# VITE_SENTRY_DSN=https://<key>@o0.ingest.sentry.io/<project>
# Shown in error reports (e.g. a git commit).
# VITE_RELEASE=dev
# Set to false to keep error reports in the browser only.
# VITE_REPORT_ERRORS=true
