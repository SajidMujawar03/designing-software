{
  "name": "@figma/desktop",
  "productName": "Design Clone",
  "version": "0.3.0",
  "private": true,
  "description": "Design Clone for the desktop",
  "author": "Sajid Mujawar",
  "homepage": "https://github.com/SajidMujawar03/designing-software",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "node build.mjs",
    "dev": "node build.mjs && electron . --dev",
    "start": "electron .",
    "smoke": "node build.mjs && electron . --smoke",
    "typecheck": "tsc -p .",
    "dist": "node build.mjs && electron-builder --publish never",
    "dist:dir": "node build.mjs && electron-builder --dir --publish never"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "electron": "^45.4.1",
    "electron-builder": "26.18.0",
    "electron-updater": "6.8.11",
    "esbuild": "0.21.5",
    "typescript": "^5.9.3",
    "yjs": "^13.6.33"
  }
}
